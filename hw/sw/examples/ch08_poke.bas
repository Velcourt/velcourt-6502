10 COLOR 1,0:CLS
20 FOR C=0 TO 15:FOR Y=150 TO 169:A=16384+Y*160+C*10
30 FOR I=0 TO 9:POKE A+I,C*17:NEXT:NEXT:NEXT
40 FOR X=0 TO 319:Y=100+INT(40*SIN(X/25)):C=7:GOSUB 100
50 PLOT X,100+INT(40*COS(X/25)),3:NEXT
60 END
100 A=16384+Y*160+INT(X/2):B=PEEK(A)
110 IF X AND 1 THEN POKE A,(B AND 240)+C:RETURN
120 POKE A,(B AND 15)+C*16:RETURN
