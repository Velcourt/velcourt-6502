# full.script - keyboard, graphics, sound, SD card and the monitor
expect MEMORY SIZE
send \r
expect WIDTH
send \r
expect BYTES FREE
expect OK\r\n
# type a program on the PS/2 keyboard
ps2 10 COLOR 1,0:CLS\r
ps2 20 FOR I=0 TO 319 STEP 8\r
ps2 30 LINE 160,100,I,0,(I/8) AND 15\r
ps2 40 LINE 160,100,319-I,199,(I/8+5) AND 15\r
ps2 50 NEXT\r
ps2 60 FOR A=0 TO 6.28 STEP .02\r
ps2 70 PLOT 160+60*COS(A),100+60*SIN(A),7\r
ps2 80 NEXT\r
ps2 90 PRINT "VELCOURT 6502"\r
ps2 RUN\r
expect VELCOURT 6502\r\n
expect OK\r\n
frame out_graphics.ppm
send SOUND 0,262,10:SOUND 1,330,10:SOUND 2,392,10\r
expect OK\r\n
wav out_chord.wav 300
send SOUND 0,0,0:SOUND 1,0,0:SOUND 2,0,0\r
expect OK\r\n
# type-ahead while a program runs must not lose keys
send FOR I=1 TO 300:NEXT:PRINT "DONE"\r
send PRINT "TYPED AHEAD"\r
expect TYPED AHEAD\r\n
expect OK\r\n
send SAVE "DEMO"\r
expect SAVED
expect OK\r\n
send SAVE "SECOND"\r
expect OK\r\n
send NEW\r
expect OK\r\n
send LIST\r
expect OK\r\n
send LOAD "DEMO"\r
expect LOADED
send LIST 10-30\r
expect 30 LINE
expect OK\r\n
send LOAD "$"\r
expect OK\r\n
frame out_files.ppm
reset S2
expect MONITOR
expect *
send D E100 E11F\r
expect *
send E 0600 A9 41 20 00 FF 60\r
expect *
send G 0600\r
expect *
frame out_monitor.ppm
quit
