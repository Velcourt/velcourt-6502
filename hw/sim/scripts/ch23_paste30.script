# ch23_paste30.script - a 30-line paste, sent back to back, then LIST
expect MEMORY SIZE
send \r
expect WIDTH
send \r
expect OK\r\n
send 10 PRINT "LINE 1 OF THE PASTE TEST":REM ABCDEFGH\r
send 20 PRINT "LINE 2 OF THE PASTE TEST":REM ABCDEFGH\r
send 30 PRINT "LINE 3 OF THE PASTE TEST":REM ABCDEFGH\r
send 40 PRINT "LINE 4 OF THE PASTE TEST":REM ABCDEFGH\r
send 50 PRINT "LINE 5 OF THE PASTE TEST":REM ABCDEFGH\r
send 60 PRINT "LINE 6 OF THE PASTE TEST":REM ABCDEFGH\r
send 70 PRINT "LINE 7 OF THE PASTE TEST":REM ABCDEFGH\r
send 80 PRINT "LINE 8 OF THE PASTE TEST":REM ABCDEFGH\r
send 90 PRINT "LINE 9 OF THE PASTE TEST":REM ABCDEFGH\r
send 100 PRINT "LINE 10 OF THE PASTE TEST":REM ABCDEFGH\r
send 110 PRINT "LINE 11 OF THE PASTE TEST":REM ABCDEFGH\r
send 120 PRINT "LINE 12 OF THE PASTE TEST":REM ABCDEFGH\r
send 130 PRINT "LINE 13 OF THE PASTE TEST":REM ABCDEFGH\r
send 140 PRINT "LINE 14 OF THE PASTE TEST":REM ABCDEFGH\r
send 150 PRINT "LINE 15 OF THE PASTE TEST":REM ABCDEFGH\r
send 160 PRINT "LINE 16 OF THE PASTE TEST":REM ABCDEFGH\r
send 170 PRINT "LINE 17 OF THE PASTE TEST":REM ABCDEFGH\r
send 180 PRINT "LINE 18 OF THE PASTE TEST":REM ABCDEFGH\r
send 190 PRINT "LINE 19 OF THE PASTE TEST":REM ABCDEFGH\r
send 200 PRINT "LINE 20 OF THE PASTE TEST":REM ABCDEFGH\r
send 210 PRINT "LINE 21 OF THE PASTE TEST":REM ABCDEFGH\r
send 220 PRINT "LINE 22 OF THE PASTE TEST":REM ABCDEFGH\r
send 230 PRINT "LINE 23 OF THE PASTE TEST":REM ABCDEFGH\r
send 240 PRINT "LINE 24 OF THE PASTE TEST":REM ABCDEFGH\r
send 250 PRINT "LINE 25 OF THE PASTE TEST":REM ABCDEFGH\r
send 260 PRINT "LINE 26 OF THE PASTE TEST":REM ABCDEFGH\r
send 270 PRINT "LINE 27 OF THE PASTE TEST":REM ABCDEFGH\r
send 280 PRINT "LINE 28 OF THE PASTE TEST":REM ABCDEFGH\r
send 290 PRINT "LINE 29 OF THE PASTE TEST":REM ABCDEFGH\r
send 300 PRINT "LINE 30 OF THE PASTE TEST":REM ABCDEFGH\r
wait 3000
send LIST\r
expect OK\r\n
quit
