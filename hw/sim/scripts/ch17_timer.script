# ch17_timer.script - load sw/examples/ch17_timer.s with L, run it with G,
# then look at ticks and at the VIA
reset S2
expect *
send L\r
expect SEND THE HEX FILE NOW
send :1006000078ADF00285F3ADF10285F4A95A8DF002C0\r
send :10061000A9068DF102A90085F1A9408D2BBFA9374C\r
send :100620008D24BFA9318D25BFA9C08D2EBF58A23002\r
send :10063000A5F118690A85F2A5F1C5F2D0FA8A200061\r
send :10064000FFE8E03AD0EA78A97F8D2EBFAD24BFA5A0\r
send :10065000F38DF002A5F48DF1026048AD24BFE6F100\r
send :07066000A5F18D20BF6840E9\r
send :00000001FF\r
expect *\r\n*
send G 0600\r
expect 0123456789
expect *
send D 00F0 00F7\r
expect 00F0:
expect *
send D BF20 BF27\r
expect BF20:
expect *
quit
