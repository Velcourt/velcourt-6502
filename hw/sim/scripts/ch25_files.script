# ch25_files.script - SAVE, LOAD and LOAD "$" on the simulated SD card
# run: ./obj_soc/sim_soc scripts/ch25_files.script out/ch25_sd.img
expect MEMORY SIZE
send \r
expect WIDTH
send \r
expect OK\r\n
# a blank card: the directory is empty
send LOAD "$"\r
expect OK\r\n
send 10 PRINT "HELLO FROM THE CARD"\r
send 20 FOR I=1 TO 3:PRINT I*I:NEXT\r
send SAVE "hello"\r
expect SAVED
expect OK\r\n
send 30 PRINT "VERSION TWO"\r
send SAVE "HELLO2"\r
expect SAVED
expect OK\r\n
send NEW\r
expect OK\r\n
send LOAD "HELLO"\r
expect LOADED
expect OK\r\n
send LIST\r
expect OK\r\n
send RUN\r
expect OK\r\n
send LOAD "NOPE"\r
expect OK\r\n
send LOAD "$"\r
expect OK\r\n
frame out/ch25_files.ppm
quit
