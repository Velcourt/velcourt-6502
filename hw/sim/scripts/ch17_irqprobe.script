# ch17_irqprobe.script - load sw/examples/ch17_irqprobe.s with L, run it
# with G, press S2 for the NMI, then dump the results
reset S2
expect *
send L\r
expect SEND THE HEX FILE NOW
send :10060000BA00EABDFE008D0007BDFF008D0107BDE9\r
send :1006100000018D0207A97F8D2EBFA9008D2BBFA9D8\r
send :10062000C08D2EBFA9648D24BFA9008D25BF2C2DA0\r
send :10063000BF10FBBA5878BDFE008D0307BDFF008DCB\r
send :100640000407BD00018D0507208D068D0607AD242A\r
send :10065000BF208D068D0707A97F8D2EBFA200BD9BF1\r
send :1006600006F0062000FFE8D0F5BAA9009DFE009D27\r
send :10067000FF009D0001BDFE00F0FBBDFE008D0807E0\r
send :10068000BDFF008D0907BD00018D0A0760A9FF8D20\r
send :1006900028BF8D29BF5878AD28BF605052455353AD\r
send :0606A0002053320D0A0098\r
send :00000001FF\r
expect *\r\n*
send G 0600\r
expect PRESS S2
wait 5
button 30
expect *
send D 0700 070F\r
expect 0708:
expect *
quit
