// tangnano20k.cst - pin assignments for the Sipeed Tang Nano 20K
// Build Your Own 6502 Computer on an FPGA - Adrian Velcourt

IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33;

IO_LOC "btn_reset" 88;
IO_LOC "btn_user" 87;
IO_PORT "btn_reset" IO_TYPE=LVCMOS33;
IO_PORT "btn_user" IO_TYPE=LVCMOS33;

IO_LOC "led_n[0]" 15;
IO_LOC "led_n[1]" 16;
IO_LOC "led_n[2]" 17;
IO_LOC "led_n[3]" 18;
IO_LOC "led_n[4]" 19;
IO_LOC "led_n[5]" 20;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 DRIVE=8;

// HDMI: each lane is a differential pair (p, n)
IO_LOC "tmds_clk_p" 33;
IO_LOC "tmds_clk_n" 34;
IO_LOC "tmds_p[0]" 35;
IO_LOC "tmds_n[0]" 36;
IO_LOC "tmds_p[1]" 37;
IO_LOC "tmds_n[1]" 38;
IO_LOC "tmds_p[2]" 39;
IO_LOC "tmds_n[2]" 40;

// USB serial through the BL616 debugger chip
IO_LOC "uart_rx" 70;
IO_LOC "uart_tx" 69;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;

// microSD slot
IO_LOC "sd_sck" 83;
IO_LOC "sd_mosi" 82;
IO_LOC "sd_miso" 84;
IO_LOC "sd_cs_n" 81;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// on-board audio amplifier (I2S)
IO_LOC "pa_en" 51;
IO_LOC "i2s_din" 54;
IO_LOC "i2s_ws" 55;
IO_LOC "i2s_bck" 56;

// PS/2 keyboard on the header (open-collector lines, pulled up to 3.3 V)
IO_LOC "ps2_clk" 52;
IO_LOC "ps2_dat" 53;
IO_PORT "ps2_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "ps2_dat" IO_TYPE=LVCMOS33 PULL_MODE=UP;
